# Proteksi file konfigurasi dan data lokal dari akses langsung browser
<FilesMatch "^(config\.php|config\.example\.php|storage\.php|.*\.(sqlite|db|json|log|sql|md))$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</FilesMatch>
